@* ===== Actualites.cshtml ===== *@
@model List<HuissariatPro.ViewModels.Actualite>
@{
    ViewData["Title"] = "Actualités"; Layout = "_LayoutSite";
}
<section class="section">
    <div class="container">
        <div class="sec-head"><span class="eyebrow">COMMUNIQUÉS</span><h2>Actualités & Communiqués</h2></div>
        <div class="grid-3">
            @foreach (var a in Model)
            {
                <article class="news"><div class="news-img">@a.Icone</div><span class="news-date">@a.DatePublication.ToString("dd MMM yyyy") • @a.Categorie</span><h3>@a.Titre</h3><p>@a.Contenu</p><a asp-action="ActualiteDetails" asp-route-id="@a.Id">Lire →</a></article>
            }
        </div>
    </div></section>