FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS base
WORKDIR /app
EXPOSE 8080
ENV ASPNETCORE_URLS=http://+:8080

FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY ["HuissariatPro.csproj", "./"]
RUN dotnet restore "HuissariatPro.csproj"
COPY . .
RUN dotnet build "HuissariatPro.csproj" -c Release -o /app/build

FROM build AS publish
RUN dotnet publish "HuissariatPro.csproj" -c Release -o /app/publish

FROM base AS final
WORKDIR /app
COPY --from=publish /app/publish .
ENTRYPOINT ["dotnet", "HuissariatPro.dll"]